{
	"name": "Incremental load",
	"properties": {
		"activities": [
			{
				"name": "fetch watermarktable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select watermarkdatetime \t\t\t\tfrom [dbo].[watermarktable] where tablename='products'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_watermarktable",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "fetch max modified date from product",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select max(modifieddate) as maxmodifieddate from [dbo].[Products]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_product_incremental",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Copy data from produc table to stagetable only changes",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "fetch watermarktable",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "fetch max modified date from product",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat('select * from [dbo].[Products] where modifieddate>''',activity('fetch watermarktable').output.firstRow.watermarkdatetime,''' and modifieddate <= ''',activity('fetch max modified date from product').output.firstRow.maxmodifieddate,'''')\n\n\n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "SqlServerSink",
						"preCopyScript": "truncate table stg.products",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_product_incremental",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_stagetable_product",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "update with maxmodified date",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy data from produc table to stagetable only changes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_sqlserver",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "@concat('update [dbo].[watermarktable] set watermarkdatetime=''',activity('fetch max modified date from product').output.firstRow.maxmodifieddate,''' where tablename=''products''')\n\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2024-11-26T15:32:00Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}