{
	"name": "migrating from on prem sol1",
	"properties": {
		"activities": [
			{
				"name": "fetching file name",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('Tablelist')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy from onprem to adls",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "sqlsource",
									"type": "DatasetReference",
									"parameters": {
										"Tablename": {
											"value": "@item().SourceTableName",
											"type": "Expression"
										},
										"Schemaname": {
											"value": "@item().SourceSchema",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@item().SinkFileName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"variables": {
			"Tablelist": {
				"type": "Array",
				"defaultValue": [
					{
						"SourceSchema": "mig",
						"SourceTableName": "Customers",
						"SinkFileName": "Raw_Customers"
					},
					{
						"SourceSchema": "mig",
						"SourceTableName": "Products",
						"SinkFileName": "Raw_Products"
					},
					{
						"SourceSchema": "mig",
						"SourceTableName": "Orders",
						"SinkFileName": "Raw_Orders"
					},
					{
						"SourceSchema": "mig",
						"SourceTableName": "OrdersItems",
						"SinkFileName": "Raw_OrdersItems"
					},
					{
						"SourceSchema": "mig",
						"SourceTableName": "Inventory",
						"SinkFileName": "Raw_Inventory"
					}
				]
			}
		},
		"annotations": [],
		"lastPublishTime": "2024-11-22T11:09:43Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}