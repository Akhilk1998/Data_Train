{
	"name": "windowtransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_employee",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "window1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          empid as string,",
				"          ename as string,",
				"          job as string,",
				"          mgr as string,",
				"          hiredate as string,",
				"          sal as integer,",
				"          comm as string,",
				"          deptno as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 window(over(deptno),",
				"     asc(sal, true),",
				"     avgSalary = avg(sal),",
				"          minSalary = min(sal)) ~> window1"
			]
		}
	}
}